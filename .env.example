# ─────────────────────────────────────────────────
#  PostgreSQL
# ─────────────────────────────────────────────────
POSTGRES_USER=chetka
POSTGRES_PASSWORD=chetka_secret
POSTGRES_DB=chetka_db
DATABASE_URL=postgresql://chetka:chetka_secret@localhost:5432/chetka_db

# ─────────────────────────────────────────────────
#  Redis
# ─────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─────────────────────────────────────────────────
#  RabbitMQ
# ─────────────────────────────────────────────────
RABBITMQ_USER=chetka
RABBITMQ_PASSWORD=rabbitmq_secret
RABBITMQ_URL=amqp://chetka:rabbitmq_secret@localhost:5672/chetka_vhost

# ─────────────────────────────────────────────────
#  JWT (ОБЯЗАТЕЛЬНО СМЕНИТЬ В ПРОДАКШНЕ!)
# ─────────────────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_CHANGE_IN_PRODUCTION
JWT_REFRESH_SECRET=super_secret_refresh_key_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────────
#  App
# ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
