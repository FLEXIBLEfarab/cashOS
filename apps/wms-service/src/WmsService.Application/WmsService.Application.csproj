<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WmsService.Application</RootNamespace>
  </PropertyGroup>

  <!--
    Application Layer (CQRS):
    - Commands / Queries (MediatR)
    - Handlers
    - Validators (FluentValidation)
    - DTOs (Application-level)
    - Interfaces (IRepository, IUnitOfWork, etc.)
    - Mappings
  -->

  <ItemGroup>
    <ProjectReference Include="..\WmsService.Domain\WmsService.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.2.0" />
    <PackageReference Include="FluentValidation" Version="11.9.0" />
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
  </ItemGroup>

</Project>
