{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=chetka_wms;Username=chetka;Password=chetka_secret"
  },
  "RabbitMQ": {
    "HostName": "rabbitmq",
    "UserName": "chetka",
    "Password": "rabbitmq_secret",
    "VirtualHost": "chetka_vhost",
    "Port": 5672
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "AllowedHosts": "*"
}
